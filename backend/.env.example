DATABASE_URL=postgresql://hostelpulse:hostelpulse_local_dev@127.0.0.1:5432/hostelpulse

# Optional Telegram bot notifications and /status command
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Demo crowd levels: occupancy >= 5 is Moderate; >= 10 is Busy
CROWD_MODERATE_THRESHOLD=5
CROWD_BUSY_THRESHOLD=10
MESS_CAPACITY=80

# MQTT topic for the crowd-level message sent to the ESP8266 LED indicator
MQTT_CROWD_LEVEL_TOPIC=hostelpulse/mess/mess-node-01/crowd-level
